# Copy to .env.local and fill in. Never commit real credentials.

# --- Storage -------------------------------------------------------------
# SQLite database file. Defaults to ./data/invoices.db (created automatically).
# DATABASE_PATH=./data/invoices.db

# --- Email (SMTP) --------------------------------------------------------
# Any email service that offers SMTP works, including free sandbox
# ("email testing") inboxes, which are ideal for demos.
# Leave SMTP_HOST empty in development to use a disposable test inbox.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); defaults to true only on 465.
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Sender shown to recipients. Must be an address your provider lets you send from.
EMAIL_FROM="Invoice Generator <invoices@your-verified-domain.com>"

# Optional safety net while testing: comma-separated addresses or @domains
# that may receive email. Anything else is rejected with 403.
EMAIL_ALLOWED_RECIPIENTS=you@example.com
